 {
     archive_read_support_filter_all(archive.get());
     archive_read_support_format_all(archive.get());
@@ -91,6 +95,23 @@ static void extract_archive(TarArchive & archive, const Path & destDir)
 {
     requireCString(destDir);
 
+    // if there is both an actCopyPath and an actCopyPath*s* at the same time,
+    // `progress-bar.cc` will combine them and show "X copied (Y MiB)"
+    // we can use this to show both how many files have been unpacked, but also
+    // how much storage they represent
+    auto unpackedCount =
+        logger->startActivity(lvlInfo, actCopyPaths, fmt("unpacking tarball '%s'", archive.name));
+    auto unpackedSize =
+        logger->startActivity(lvlInfo, actCopyPath, fmt("unpacking tarball '%s'", archive.name));
+
+    size_t processedFiles = 0;
+    size_t processedBytes = 0;
+
+    // keeps track of the value of `processedBytes` the last time we reported progress
+    size_t lastLoggedBytes = 0;
+    // to avoid log spam, we only log at constant size increments (here, 100 KiB)
+    constexpr auto logIncrement = 100l * 1024;
+
     int flags =
         ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_SECURE_SYMLINKS | ARCHIVE_EXTRACT_SECURE_NODOTDOT;
 
@@ -129,12 +150,29 @@ static void extract_archive(TarArchive & archive, const Path & destDir)
         }
 
         archive.check(archive_read_extract(archive.archive.get(), entry, flags));
+
+        // only count regular files (e.g. directories would double-count the size of the files under them)
+        if (archive_entry_filetype(entry) == AE_IFREG) {
+            processedFiles++;
+            processedBytes += archive_entry_size(entry);
+            // avoid log chatter by only progressing every once in a while
+            if ((processedBytes - lastLoggedBytes) > logIncrement) {
+                lastLoggedBytes = processedBytes;
+                // note: we discard the BufferState because these logs are not essential and
+                //       don't need to wait for flushing
+                (void) unpackedCount.progress(processedFiles);
+                (void) unpackedSize.progress(processedBytes);
+            }
+        }
     }
 
+    (void) unpackedCount.progress(processedFiles);
+    (void) unpackedSize.progress(processedBytes);
+
     archive.close();
 }
 
