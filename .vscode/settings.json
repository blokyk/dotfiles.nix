{
    "cSpell.words": [
        "bindkey",
        "clipcopy",
        "clippaste",
        "compinit",
        "egui",
        "gnused",
        "MANPAGER",
        "manpages",
        "pciutils",
        "ringboard",
        "specialisation",
        "xclip"
    ],
    "nix.serverSettings": {
        "nixd": {
            "options": {
                "workspace": {
                    "expr": "let v = import ./.; in if (builtins.isFunction v || v ? __functor) then (v {}).options else v.options"
                }
            }
        }
    },
    "path-intellisense.mappings": {
        "self": "${workspaceFolder}",
    },
}
